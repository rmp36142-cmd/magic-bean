# Copy to .env.local and fill in your own keys.

# Free tier: https://www.pexels.com/api/
PEXELS_API_KEY=

# Free tier: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Any OpenAI-compatible chat completions endpoint (DeepSeek, Kimi, GLM,
# a self-hosted proxy, etc.). Must expose POST {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
